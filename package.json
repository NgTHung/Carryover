{
  "name": "carryover",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --dev-client",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "ios": "expo run:ios",
    "prebuild": "node scripts/patch-expo-widgets.mjs && expo prebuild --platform ios --clean && node scripts/strip-push-entitlement.mjs",
    "test": "jest",
    "test:logic": "jest --selectProjects logic",
    "test:database": "jest --selectProjects database",
    "test:component": "jest --selectProjects component",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.14",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.18",
    "expo-dev-client": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-widgets": "~57.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "babel-jest": "29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "expo-doctor": "^1.20.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
